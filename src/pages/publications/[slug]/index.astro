---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { inferPublicationSortDate } from "@/utils/inferPublicationSortDate";
import {
  publicationVenueLabel,
  publicationVenueToHtml,
} from "@/utils/publicationVenue";
import { buildAuthorLinkMap } from "@/utils/authorLink";
import AuthorList from "@/components/AuthorList.astro";

export async function getStaticPaths() {
  const publications = await getCollection("publications");
  return publications.map(pub => ({
    params: { slug: pub.id },
    props: { pub },
  }));
}

interface Link {
  name: string;
  url: string;
}

const { pub } = Astro.props;
const { data, body } = pub;

const team = await getCollection("team");
const authorLinkMap = buildAuthorLinkMap(team);

const effectiveDate = inferPublicationSortDate({
  slug: pub.id,
  publication: data.publication,
  urlPdf: data.urlPdf,
  existingDate: data.date,
});

const venueDisplay = publicationVenueLabel(data.publication, data.urlPdf);
---

<Layout
  title={`${data.title} | Tong Group`}
  description={data.abstract || data.title}
  pubDatetime={effectiveDate}
  schema="scholarlyArticle"
  articleAuthors={data.authors}
>
  <Main pageTitle={data.title}>
    <section class="space-y-6">
      <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        {
          venueDisplay && (
            <div class="border-b border-border pb-4 not-italic">
              <h2 class="text-sm font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">
                Publication
              </h2>
              <p
                class="app-prose prose-p:my-0 mt-2 text-lg text-gray-800 dark:text-gray-100"
                set:html={publicationVenueToHtml(venueDisplay)}
              />
            </div>
          )
        }
        {
          data.image && (
            <div class="mb-4">
              <Image
                src={data.image}
                alt={data.title}
                class="rounded-lg w-full max-w-2xl"
              />
              {
                data.imageCaption && (
                  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                    {data.imageCaption}
                  </p>
                )
              }
            </div>
          )
        }

        {
          data.subtitle && (
            <p class="text-xl text-gray-700 dark:text-gray-300">
              {data.subtitle}
            </p>
          )
        }

        <div class="mt-4">
          <h2 class="text-lg font-semibold">Authors</h2>
          <AuthorList
            authors={data.authors}
            authorNotes={data.authorNotes}
            authorLinkMap={authorLinkMap}
            class="mt-2 text-gray-700 dark:text-gray-300"
          />
        </div>

        {
          data.date && (
            <div class="mt-4">
              <h2 class="text-lg font-semibold">Date</h2>
              <p class="text-gray-700 dark:text-gray-300">
                {effectiveDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
            </div>
          )
        }

        {
          data.abstract && (
            <div class="mt-4">
              <h2 class="text-lg font-semibold">Abstract</h2>
              <p class="mt-2 text-gray-700 dark:text-gray-300">
                {data.abstract}
              </p>
            </div>
          )
        }

        {
          body && (
            <div class="mt-6">
              <h2 class="text-lg font-semibold">Details</h2>
              <div class="prose dark:prose-invert mt-2">
                <slot />
              </div>
            </div>
          )
        }

        <div class="mt-6 flex flex-wrap gap-2">
          {
            data.urlPdf && (
              <a
                href={data.urlPdf}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded bg-blue-600 px-4 py-2 text-sm text-white hover:bg-blue-700"
              >
                PDF
              </a>
            )
          }
          {
            data.urlCode && (
              <a
                href={data.urlCode}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded bg-gray-200 px-4 py-2 text-sm hover:bg-blue-600 hover:text-white dark:bg-gray-700"
              >
                Code
              </a>
            )
          }
          {
            data.links && data.links.map((link: Link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded bg-gray-200 px-4 py-2 text-sm hover:bg-blue-600 hover:text-white dark:bg-gray-700"
              >
                {link.name}
              </a>
            ))
          }
        </div>

        {
          data.tags && data.tags.length > 0 && (
            <div class="mt-4">
              <div class="flex flex-wrap gap-2">
                {data.tags.map((tag: string) => (
                  <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </section>
  </Main>
</Layout>