---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { inferPublicationSortDate } from "@/utils/inferPublicationSortDate";
import {
  publicationVenueLabel,
  publicationVenueToHtml,
} from "@/utils/publicationVenue";
import { buildAuthorLinkMap } from "@/utils/authorLink";
import AuthorList from "@/components/AuthorList.astro";

const publications = await getCollection("publications");
const team = await getCollection("team");
const authorLinkMap = buildAuthorLinkMap(team);

publications.sort(
  (a, b) =>
    inferPublicationSortDate({
      slug: b.id,
      publication: b.data.publication,
      urlPdf: b.data.urlPdf,
      existingDate: b.data.date,
    }).getTime() -
    inferPublicationSortDate({
      slug: a.id,
      publication: a.data.publication,
      urlPdf: a.data.urlPdf,
      existingDate: a.data.date,
    }).getTime()
);

type PubDoc = (typeof publications)[number];
const recentPublicationYearGroups: { year: number; pubs: PubDoc[] }[] = [];
for (const pub of publications) {
  const sortDate = inferPublicationSortDate({
    slug: pub.id,
    publication: pub.data.publication,
    urlPdf: pub.data.urlPdf,
    existingDate: pub.data.date,
  });
  const year = sortDate.getUTCFullYear();
  const tail = recentPublicationYearGroups[recentPublicationYearGroups.length - 1];
  if (!tail || tail.year !== year) {
    recentPublicationYearGroups.push({ year, pubs: [pub] });
  } else {
    tail.pubs.push(pub);
  }
}
---

<Layout
  title="Publications | Tong Group"
  description="Research publications and papers"
>
  <Main
    pageTitle="Publications"
    pageDesc="Selected publications from Tong Group"
  >
    <section class="space-y-8">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        <sup>*</sup> These authors contributed equally.
        <sup>†</sup> These authors jointly supervised this work.
      </p>
      <!-- Publications from MD files -->
      {
        publications.length > 0 && (
          <section class="space-y-6">
            <h2 class="text-3xl font-bold">Recent Publications</h2>
            <div class="space-y-10">
              {recentPublicationYearGroups.map(({ year, pubs }) => (
                <div class="space-y-4">
                  <h3 class="border-b border-gray-200 pb-2 text-2xl font-semibold text-gray-800 dark:border-gray-600 dark:text-gray-100">
                    {year}
                  </h3>
                  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    {pubs.map(pub => {
                      const venueLabel = publicationVenueLabel(
                        pub.data.publication,
                        pub.data.urlPdf
                      );
                      return (
                        <article class="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800">
                          <h4 class="mb-2 text-lg font-semibold text-blue-600 dark:text-blue-400">
                            <a href={`/publications/${pub.id}`}>
                              {pub.data.title}
                            </a>
                          </h4>
                          <AuthorList
                            authors={pub.data.authors}
                            authorNotes={pub.data.authorNotes}
                            authorLinkMap={authorLinkMap}
                            class="mb-2"
                          />
                          {
                            venueLabel && (
                              <p
                                class="mb-2 line-clamp-2 text-sm text-gray-700 dark:text-gray-300"
                                set:html={publicationVenueToHtml(venueLabel)}
                              />
                            )
                          }
                          <p class="mb-2 text-xs text-gray-500 dark:text-gray-500">
                            {inferPublicationSortDate({
                              slug: pub.id,
                              publication: pub.data.publication,
                              urlPdf: pub.data.urlPdf,
                              existingDate: pub.data.date,
                            }).toLocaleDateString()}
                          </p>
                          {pub.data.abstract && (
                            <p class="line-clamp-3 text-sm">{pub.data.abstract}</p>
                          )}
                          {pub.data.urlPdf && (
                            <a
                              href={pub.data.urlPdf}
                              class="text-sm text-blue-600 dark:text-blue-400"
                            >
                              PDF
                            </a>
                          )}
                        </article>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </section>
  </Main>
</Layout>
