---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { resolveAuthorSlug, buildAuthorLinkMap } from "@/utils/authorLink";
import { inferPublicationSortDate } from "@/utils/inferPublicationSortDate";
import {
  publicationVenueLabel,
  publicationVenueToHtml,
} from "@/utils/publicationVenue";

const { slug } = Astro.params;
const team = await getCollection("team");

export async function getStaticPaths() {
  const members = await getCollection("team");
  return members.map(member => ({
    params: {
      slug: member.id,
    },
  }));
}

const member = team.find(item => item.id === slug);

if (!member) {
  throw new Error("Team member not found");
}

const { data } = member;

// Find lab publications this member co-authored.
const publications = await getCollection("publications");
const authorLinkMap = buildAuthorLinkMap(team);
const memberPubs = publications
  .filter(pub =>
    pub.data.authors.some(
      author => resolveAuthorSlug(author, authorLinkMap) === member.id
    )
  )
  .sort(
    (a, b) =>
      inferPublicationSortDate({
        slug: b.id,
        publication: b.data.publication,
        urlPdf: b.data.urlPdf,
        existingDate: b.data.date,
      }).getTime() -
      inferPublicationSortDate({
        slug: a.id,
        publication: a.data.publication,
        urlPdf: a.data.urlPdf,
        existingDate: a.data.date,
      }).getTime()
  );
---

<Layout
  title={`Team | ${data.name}`}
  description={`Profile for ${data.name} in the Tong Group`}
>
  <Main pageTitle={data.name} pageDesc={data.role}>
    <section class="space-y-6">
      <div
        class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800"
      >
        <div
          class="flex flex-col items-center gap-4 sm:flex-row sm:items-start"
        >
          {
            data.photo ? (
              <Image
                src={data.photo}
                alt={data.name}
                class="h-40 w-40 rounded-full object-cover"
                width={160}
                height={160}
              />
            ) : (
              <div class="flex h-40 w-40 items-center justify-center rounded-full bg-blue-500 text-4xl font-bold text-white">
                {data.name.charAt(0)}
              </div>
            )
          }
          <div class="space-y-2 text-center sm:text-left">
            <p
              class="text-sm font-semibold tracking-wide text-blue-600 uppercase dark:text-blue-400"
            >
              {data.role}
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-300">
              {
                data.website ? (
                  <a
                    class="text-blue-600 hover:underline"
                    href={data.website}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {data.website}
                  </a>
                ) : null
              }
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-300">
              {
                data.email ? (
                  <a
                    class="text-blue-600 hover:underline"
                    href={`mailto:${data.email}`}
                  >
                    {data.email}
                  </a>
                ) : null
              }
            </p>
          </div>
        </div>

        <div class="mt-6">
          <h2 class="text-xl font-semibold">About</h2>
          <p class="mt-2 text-gray-700 dark:text-gray-300">{data.bio}</p>
        </div>

        {
          data.specialization && data.specialization.length > 0 && (
            <div class="mt-4">
              <h3 class="text-md font-semibold">Specialization</h3>
              <div class="mt-2 flex flex-wrap gap-2">
                {data.specialization.map(item => (
                  <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          )
        }

        <div class="mt-6 flex flex-wrap gap-2">
          {
            data.github && (
              <a
                href={`https://github.com/${data.github}`}
                class="rounded bg-gray-200 px-4 py-2 text-sm hover:bg-blue-600 hover:text-white dark:bg-gray-700 dark:hover:bg-blue-600"
              >
                GitHub
              </a>
            )
          }
          {
            data.twitter && data.twitter !== "n/a" && (
              <a
                href={`https://twitter.com/${data.twitter}`}
                class="rounded bg-gray-200 px-4 py-2 text-sm hover:bg-blue-600 hover:text-white dark:bg-gray-700 dark:hover:bg-blue-600"
              >
                Twitter
              </a>
            )
          }
          {
            data.linkedin && (
              <a
                href={`https://www.linkedin.com/in/${data.linkedin}`}
                class="rounded bg-gray-200 px-4 py-2 text-sm hover:bg-blue-600 hover:text-white dark:bg-gray-700 dark:hover:bg-blue-600"
              >
                LinkedIn
              </a>
            )
          }
        </div>
      </div>

      {
        memberPubs.length > 0 && (
          <div
            class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800"
          >
            <h2 class="text-xl font-semibold">Publications</h2>
            <ul class="mt-4 space-y-4">
              {memberPubs.map(pub => {
                const venueLabel = publicationVenueLabel(
                  pub.data.publication,
                  pub.data.urlPdf
                );
                const sortDate = inferPublicationSortDate({
                  slug: pub.id,
                  publication: pub.data.publication,
                  urlPdf: pub.data.urlPdf,
                  existingDate: pub.data.date,
                });
                return (
                  <li class="border-b border-gray-100 pb-4 last:border-0 last:pb-0 dark:border-gray-700">
                    <h3 class="text-base font-semibold text-blue-600 dark:text-blue-400">
                      <a href={`/publications/${pub.id}`}>{pub.data.title}</a>
                    </h3>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                      {pub.data.authors.map((author: string, i: number) => (
                        <>
                          {i > 0 && ", "}
                          {(() => {
                            const authorSlug = resolveAuthorSlug(author, authorLinkMap);
                            return authorSlug
                              ? <a href={`/team/${authorSlug}`} class="text-blue-600 hover:underline dark:text-blue-400">{author}</a>
                              : author;
                          })()}
                        </>
                      ))}
                    </p>
                    {venueLabel && (
                      <p
                        class="mt-1 text-sm text-gray-700 dark:text-gray-300"
                        set:html={publicationVenueToHtml(venueLabel)}
                      />
                    )}
                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-500">
                      {sortDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                      })}
                    </p>
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }
    </section>
  </Main>
</Layout>
