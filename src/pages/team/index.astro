---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import TeamMemberCard from "@/components/TeamMemberCard.astro";

const team = await getCollection("team");

const sortedTeam = [...team].sort((a, b) => {
  const aIsPI = a.data.role.includes("Principal Investigator");
  const bIsPI = b.data.role.includes("Principal Investigator");

  if (aIsPI && !bIsPI) return -1;
  if (!aIsPI && bIsPI) return 1;

  return a.data.name.localeCompare(b.data.name);
});

// Active members, alumni, and future members. Alumni are flagged in their YAML
// and shown in a "Where are they now" section. Future members are flagged and
// shown in a "Joining us soon" section.
const activeMembers = sortedTeam.filter(m => !m.data.alumni && !m.data.future);
const alumni = sortedTeam.filter(m => m.data.alumni);
const futureMembers = sortedTeam.filter(m => m.data.future);
---

<Layout
  title="Team | Tong Group"
  description="Meet the team members and researchers"
>
  <Main
    pageTitle="Team"
    pageDesc="Meet the talented researchers behind Tong Group"
  >
    <section class="space-y-8">
      <!-- Team Grid -->
      <div
        class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
      >
        {
          activeMembers.map(member => (
            <a href={`/team/${member.id}`} class="block min-w-0">
              <TeamMemberCard member={member} />
            </a>
          ))
        }
      </div>

      <!-- Empty State -->
      {
        activeMembers.length === 0 && (
          <div class="rounded-lg border border-gray-200 bg-gray-50 p-8 text-center dark:border-gray-700 dark:bg-gray-800">
            <p class="text-gray-600 dark:text-gray-400">
              Team members coming soon...
            </p>
          </div>
        )
      }

      <!-- Future members / Joining us soon -->
      {
        futureMembers.length > 0 && (
          <div class="pt-8">
            <h2 class="mb-6 text-2xl font-semibold tracking-wide">
              Joining us soon
            </h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
              {futureMembers.map(member => (
                <a href={`/team/${member.id}`} class="block min-w-0">
                  <TeamMemberCard member={member} />
                </a>
              ))}
            </div>
          </div>
        )
      }

      <!-- Alumni / Where are they now -->
      {
        alumni.length > 0 && (
          <div class="pt-8">
            <h2 class="mb-6 text-2xl font-semibold tracking-wide">
              Alumni — where are they now
            </h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
              {alumni.map(member => (
                <div class="rounded-lg border border-gray-200 bg-white p-6 text-center shadow-sm dark:border-gray-700 dark:bg-gray-800">
                  <h3 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">
                    {member.data.name}
                  </h3>
                  <p class="text-sm font-medium text-blue-600 dark:text-blue-400">
                    {member.data.currentPosition ?? member.data.role}
                  </p>
                  {member.data.website && (
                    <a
                      href={member.data.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-2 inline-block text-sm text-blue-600 hover:underline dark:text-blue-400"
                    >
                      Website →
                    </a>
                  )}
                </div>
              ))}
            </div>
          </div>
        )
      }
    </section>
  </Main>
</Layout>
