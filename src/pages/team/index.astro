---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import TeamMemberCard from "@/components/TeamMemberCard.astro";

const team = await getCollection("team");

const sortedTeam = [...team].sort((a, b) => {
  const aIsPI = a.data.role.includes("Principal Investigator");
  const bIsPI = b.data.role.includes("Principal Investigator");
  
  if (aIsPI && !bIsPI) return 1;
  if (!aIsPI && bIsPI) return -1;
  
  return a.data.name.localeCompare(b.data.name);
});
---

<Layout
  title="Team | Tong Group"
  description="Meet the team members and researchers"
>
  <Main
    pageTitle="Team"
    pageDesc="Meet the talented researchers behind Tong Group"
  >
    <section class="space-y-8">
      <!-- Team Grid -->
      <div
        class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
      >
        {
          sortedTeam.map(member => (
            <a href={`/team/${member.id}`} class="block">
              <TeamMemberCard member={member} />
            </a>
          ))
        }
      </div>

      <!-- Empty State -->
      {
        team.length === 0 && (
          <div class="rounded-lg border border-gray-200 bg-gray-50 p-8 text-center dark:border-gray-700 dark:bg-gray-800">
            <p class="text-gray-600 dark:text-gray-400">
              Team members coming soon...
            </p>
          </div>
        )
      }
    </section>
  </Main>
</Layout>
