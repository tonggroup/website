---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { inferPublicationSortDate } from "@/utils/inferPublicationSortDate";
import {
  publicationVenueLabel,
  publicationVenueToHtml,
} from "@/utils/publicationVenue";
import { resolveAuthorSlug, buildAuthorLinkMap } from "@/utils/authorLink";

export async function getStaticPaths() {
  const research = await getCollection("research");
  return research.map(item => ({
    params: { slug: item.id },
    props: { research: item },
  }));
}

const { research } = Astro.props;
const { data } = research;
const { Content } = await render(research);

// Resolve linked team members.
const team = await getCollection("team");
const authorLinkMap = buildAuthorLinkMap(team);
const members = (data.members ?? [])
  .map(id => team.find(m => m.id === id))
  .filter((m): m is NonNullable<typeof m> => m !== undefined);

// Resolve linked publications, sorted newest-first.
const allPubs = await getCollection("publications");
const pubs = (data.publications ?? [])
  .map(id => allPubs.find(p => p.id === id))
  .filter((p): p is NonNullable<typeof p> => p !== undefined)
  .sort(
    (a, b) =>
      inferPublicationSortDate({
        slug: b.id,
        publication: b.data.publication,
        urlPdf: b.data.urlPdf,
        existingDate: b.data.date,
      }).getTime() -
      inferPublicationSortDate({
        slug: a.id,
        publication: a.data.publication,
        urlPdf: a.data.urlPdf,
        existingDate: a.data.date,
      }).getTime()
  );
---

<Layout
  title={`Research | ${data.title}`}
  description={data.description}
>
  <Main pageTitle={data.title} pageDesc={data.description}>
    <section class="space-y-8">
      {/* Overview prose */}
      <div
        class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800"
      >
        <div class="prose prose-gray max-w-none dark:prose-invert">
          <Content />
        </div>

        {
          data.tags && data.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {data.tags.map(tag => (
                <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </div>

      {/* People */}
      {
        members.length > 0 && (
          <div
            class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800"
          >
            <h2 class="text-xl font-semibold">People</h2>
            <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
              {members.map(member => (
                <a
                  href={`/team/${member.id}`}
                  class="flex flex-col items-center gap-2 rounded-lg p-3 text-center transition-colors hover:bg-gray-50 dark:hover:bg-gray-700"
                >
                  {member.data.photo ? (
                    <Image
                      src={member.data.photo}
                      alt={member.data.name}
                      class="h-20 w-20 rounded-full object-cover"
                      width={80}
                      height={80}
                    />
                  ) : (
                    <div class="flex h-20 w-20 items-center justify-center rounded-full bg-blue-500 text-2xl font-bold text-white">
                      {member.data.name.charAt(0)}
                    </div>
                  )}
                  <div>
                    <p class="text-sm font-semibold">{member.data.name}</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">
                      {member.data.role}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* Selected Publications */}
      {
        pubs.length > 0 && (
          <div
            class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800"
          >
            <h2 class="text-xl font-semibold">Selected Publications</h2>
            <ul class="mt-4 space-y-4">
              {pubs.map(pub => {
                const venueLabel = publicationVenueLabel(
                  pub.data.publication,
                  pub.data.urlPdf
                );
                const sortDate = inferPublicationSortDate({
                  slug: pub.id,
                  publication: pub.data.publication,
                  urlPdf: pub.data.urlPdf,
                  existingDate: pub.data.date,
                });
                return (
                  <li class="border-b border-gray-100 pb-4 last:border-0 last:pb-0 dark:border-gray-700">
                    <h3 class="text-base font-semibold text-blue-600 dark:text-blue-400">
                      <a href={`/publications/${pub.id}`}>{pub.data.title}</a>
                    </h3>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                      {pub.data.authors.map((author: string, i: number) => (
                        <>
                          {i > 0 && ", "}
                          {(() => {
                            const authorSlug = resolveAuthorSlug(author, authorLinkMap);
                            return authorSlug
                              ? <a href={`/team/${authorSlug}`} class="text-blue-600 hover:underline dark:text-blue-400">{author}</a>
                              : author;
                          })()}
                        </>
                      ))}
                    </p>
                    {venueLabel && (
                      <p
                        class="mt-1 text-sm text-gray-700 dark:text-gray-300"
                        set:html={publicationVenueToHtml(venueLabel)}
                      />
                    )}
                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-500">
                      {sortDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                      })}
                    </p>
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }

      {/* External links */}
      {
        data.links && data.links.length > 0 && (
          <div
            class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800"
          >
            <h2 class="text-xl font-semibold">Links</h2>
            <div class="mt-4 flex flex-wrap gap-2">
              {data.links.map(link => (
                <a
                  href={link.url}
                  class="inline-flex items-center gap-1 rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-700"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label}
                  <span>→</span>
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* Back link */}
      <div>
        <a
          href="/research"
          class="text-sm text-blue-600 hover:underline dark:text-blue-400"
        >
          ← All research areas
        </a>
      </div>
    </section>
  </Main>
</Layout>
