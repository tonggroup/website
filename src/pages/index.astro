---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <!-- Hero Section -->
    <section id="hero" class:list={["pt-8 pb-12 sm:pt-16 sm:pb-16", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {SITE.title}
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="mt-4 text-lg">
        Advancing research in machine learning and artificial intelligence.
      </p>
      <p class="mt-2">
        Our lab focuses on developing novel algorithms, optimizing deep learning systems, and applying AI techniques to real-world problems. Explore our research areas, meet our team, or read our latest publications.
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- Highlights Section -->
    <section id="highlights" class="pt-12 pb-6 border-b border-border">
      <h2 class="text-2xl font-semibold tracking-wide mb-6">Explore</h2>
      <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        <!-- Research Highlight -->
        <li class="rounded-lg border border-gray-200 bg-white p-6 hover:shadow-lg transition-shadow dark:border-gray-700 dark:bg-gray-800">
          <h3 class="text-lg font-bold mb-2">Research</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Explore our active research areas and ongoing projects.
          </p>
          <a href="/research" class="inline-flex items-center gap-1 text-blue-600 font-semibold hover:underline dark:text-blue-400">
            View Research <IconArrowRight width={16} height={16} />
          </a>
        </li>

        <!-- Team Highlight -->
        <li class="rounded-lg border border-gray-200 bg-white p-6 hover:shadow-lg transition-shadow dark:border-gray-700 dark:bg-gray-800">
          <h3 class="text-lg font-bold mb-2">Team</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Meet the researchers and students in our lab.
          </p>
          <a href="/team" class="inline-flex items-center gap-1 text-blue-600 font-semibold hover:underline dark:text-blue-400">
            Meet the Team <IconArrowRight width={16} height={16} />
          </a>
        </li>

        <!-- Publications Highlight -->
        <li class="rounded-lg border border-gray-200 bg-white p-6 hover:shadow-lg transition-shadow dark:border-gray-700 dark:bg-gray-800">
          <h3 class="text-lg font-bold mb-2">Publications</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Browse our peer-reviewed papers and preprints.
          </p>
          <a href="/publications" class="inline-flex items-center gap-1 text-blue-600 font-semibold hover:underline dark:text-blue-400">
            View Publications <IconArrowRight width={16} height={16} />
          </a>
        </li>

        <!-- Blog Highlight -->
        <li class="rounded-lg border border-gray-200 bg-white p-6 hover:shadow-lg transition-shadow dark:border-gray-700 dark:bg-gray-800">
          <h3 class="text-lg font-bold mb-2">Blog</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Read updates, insights, and technical posts from our team.
          </p>
          <a href="/posts" class="inline-flex items-center gap-1 text-blue-600 font-semibold hover:underline dark:text-blue-400">
            Read Blog <IconArrowRight width={16} height={16} />
          </a>
        </li>
      </ul>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured Posts</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
