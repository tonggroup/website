---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import groupPhoto from "@/assets/team/tong-group-april-2026.jpg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const newsItems = await getCollection("news");

const sortedPosts = getSortedPosts(newsItems);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout
  title={`${SITE.title} | Aithyra, Vienna`}
  description={SITE.desc}
  schema="homepage"
>
  <main id="main-content" data-layout="index" class="app-layout">
    <!-- Hero Section -->
    <section
      id="hero"
      class:list={["pt-8 pb-12 sm:pt-16 sm:pb-16", "border-b border-border"]}
    >
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {SITE.title}
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <div class="mt-6 space-y-4 text-lg">
        <p>
          We are a research group at <a
            href="https://aithyra.at"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-blue-600 hover:underline dark:text-blue-400"
            >Aithyra</a
          > in Vienna, Austria, at the intersection of machine learning and life sciences.
        </p>
        <p>
          Our research focuses on <strong>generative modeling</strong>, <strong
            >flow models</strong
          >, <strong>optimal transport</strong>, and <strong
            >protein design</strong
          >. We develop novel machine learning algorithms with applications to
          understanding cellular dynamics, predicting protein structures, and
          designing new molecules.
        </p>
        <p>
          Led by <a
            href={SITE.profile}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-blue-600 hover:underline dark:text-blue-400"
            ><strong>Alexander Tong</strong></a
          >, our group combines theoretical insights with practical applications
          to solve problems in computational biology and chemistry.
        </p>
        <p class="pt-2">
          We are actively recruiting PhD students, postdocs, and visiting
          researchers. <a
            href="/join"
            class="font-semibold text-blue-600 hover:underline dark:text-blue-400"
            >See open positions</a
          > if you're interested!
        </p>
      </div>
      <figure class="mt-8">
        <Image
          src={groupPhoto}
          alt="Tong Group at Aithyra, April 2026"
          widths={[640, 960, 1280]}
          sizes="(max-width: 640px) 100vw, 960px"
          class="w-full rounded-lg object-cover shadow-sm"
        />
        <figcaption class="text-skin-muted mt-2 text-center text-sm">
          Tong Group at Aithyra, April 2026
        </figcaption>
      </figure>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Connect:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- Highlights Section -->
    <section id="highlights" class="border-b border-border pt-12 pb-6">
      <h2 class="mb-6 text-2xl font-semibold tracking-wide">Explore</h2>
      <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        <!-- Research Highlight -->
        <li
          class="rounded-lg border border-gray-200 bg-white p-6 transition-shadow hover:shadow-lg dark:border-gray-700 dark:bg-gray-800"
        >
          <h3 class="mb-2 text-lg font-bold">Research</h3>
          <p class="mb-4 text-gray-700 dark:text-gray-300">
            Explore our active research areas and ongoing projects.
          </p>
          <a
            href="/research"
            class="inline-flex items-center gap-1 font-semibold text-blue-600 hover:underline dark:text-blue-400"
          >
            View Research <IconArrowRight width={16} height={16} />
          </a>
        </li>

        <!-- Team Highlight -->
        <li
          class="rounded-lg border border-gray-200 bg-white p-6 transition-shadow hover:shadow-lg dark:border-gray-700 dark:bg-gray-800"
        >
          <h3 class="mb-2 text-lg font-bold">Team</h3>
          <p class="mb-4 text-gray-700 dark:text-gray-300">
            Meet the researchers and students in our lab.
          </p>
          <a
            href="/team"
            class="inline-flex items-center gap-1 font-semibold text-blue-600 hover:underline dark:text-blue-400"
          >
            Meet the Team <IconArrowRight width={16} height={16} />
          </a>
        </li>

        <!-- Publications Highlight -->
        <li
          class="rounded-lg border border-gray-200 bg-white p-6 transition-shadow hover:shadow-lg dark:border-gray-700 dark:bg-gray-800"
        >
          <h3 class="mb-2 text-lg font-bold">Publications</h3>
          <p class="mb-4 text-gray-700 dark:text-gray-300">
            Browse our peer-reviewed papers and preprints.
          </p>
          <a
            href="/publications"
            class="inline-flex items-center gap-1 font-semibold text-blue-600 hover:underline dark:text-blue-400"
          >
            View Publications <IconArrowRight width={16} height={16} />
          </a>
        </li>

        <!-- Join Highlight -->
        <li
          class="rounded-lg border-2 border-accent bg-white p-6 transition-shadow hover:shadow-lg dark:bg-gray-800"
        >
          <h3 class="mb-2 text-lg font-bold text-accent">
            Join the Lab
          </h3>
          <p class="mb-4 text-gray-700 dark:text-gray-300">
            Open PhD, postdoc, visiting, and intern positions in Vienna.
          </p>
          <a
            href="/join"
            class="inline-flex items-center gap-1 font-semibold text-accent hover:underline"
          >
            See Open Positions <IconArrowRight width={16} height={16} />
          </a>
        </li>
      </ul>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured News</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent News</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/news/">
        All News
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
