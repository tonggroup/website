---
import { getAuthorSymbol } from "@/utils/authorNotes";
import {
  resolveAuthorSlug,
  type AuthorLinkMap,
} from "@/utils/authorLink";

interface Props {
  authors: string[];
  authorNotes?: Record<string, string>;
  authorLinkMap: AuthorLinkMap;
  /** Extra classes for the author <p>. */
  class?: string;
}

const {
  authors,
  authorNotes,
  authorLinkMap,
  class: className = "",
} = Astro.props;

// Pre-compute per-author render nodes so the template has no multi-line
// fragment whitespace leaking between authors and commas.
const items = authors.map((author: string, i: number) => {
  const slug = resolveAuthorSlug(author, authorLinkMap);
  const symbol = getAuthorSymbol(author, i, authors, authorNotes);
  return { i, slug, symbol, author };
});
---

<p class={`text-sm text-gray-600 dark:text-gray-400 ${className}`}>{items.map(({ i, slug, symbol, author }) => (slug ? <><span>{i > 0 && ", "}</span><a href={`/team/${slug}`} class="text-blue-600 hover:underline dark:text-blue-400">{author}{symbol && <sup>{symbol}</sup>}</a></> : <><span>{i > 0 && ", "}</span><span>{author}{symbol && <sup>{symbol}</sup>}</span></>))}</p>
