---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

type Role = CollectionEntry<"joinRoles">;

interface Props {
  role: Role;
  contactEmail: string;
}

const { role, contactEmail } = Astro.props;
const { data } = role;
const { Content } = await render(role);

const statusStyles: Record<string, string> = {
  open: "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200",
  filled: "bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-300",
  paused: "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200",
};

const isOpen = data.status === "open";

// Prefilled mailto for this role.
const subject = `Application — ${data.title} (Tong Group)`;
const body = `Dear Alex,

I am writing to express interest in the ${data.title} position in the Tong Group.

Research interests:
<please describe which of our research areas you'd like to work on and why>

Background:
<one short paragraph on your relevant experience>

Relevant links:
- CV: <link or "attached">
- Code/papers: <optional link>

References:
- <name, affiliation, email>

Thank you for your consideration.`;
const mailto = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<article
  class="flex h-full flex-col rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md dark:border-gray-700 dark:bg-gray-800"
>
  <div class="mb-3 flex items-center justify-between gap-3">
    <h3 class="text-lg font-bold text-gray-900 dark:text-white">{data.title}</h3>
    <span
      class:list={[
        "rounded-full px-3 py-1 text-xs font-semibold capitalize",
        statusStyles[data.status] ?? statusStyles.open,
      ]}
    >
      {data.status}
    </span>
  </div>

  <p class="mb-4 text-sm text-gray-700 dark:text-gray-300">{data.description}</p>

  <div class="mb-4">
    <h4 class="mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">
      What we're looking for
    </h4>
    <ul class="space-y-1 text-sm text-gray-700 dark:text-gray-300">
      {data.requirements.map(req => (
        <li class="flex gap-2">
          <span class="text-blue-600 dark:text-blue-400" aria-hidden="true">›</span>
          <span>{req}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mb-5">
    <h4 class="mb-2 text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">
      What we offer
    </h4>
    <ul class="space-y-1 text-sm text-gray-700 dark:text-gray-300">
      {data.offers.map(offer => (
        <li class="flex gap-2">
          <span class="text-blue-600 dark:text-blue-400" aria-hidden="true">+</span>
          <span>{offer}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="prose prose-sm mb-5 max-w-none text-gray-700 dark:prose-invert dark:text-gray-300">
    <Content />
  </div>

  <div class="mt-auto">
    {
      isOpen ? (
        <a
          href={mailto}
          class="inline-flex w-full items-center justify-center gap-1 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-700"
        >
          Apply by email
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <p class="text-center text-sm text-gray-500 dark:text-gray-400">
          Not currently accepting applications.
        </p>
      )
    }
  </div>
</article>
