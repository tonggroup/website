---
import type { CollectionEntry } from "astro:content";

type Faq = CollectionEntry<"joinFaq">;

interface Props {
  faq: Faq;
}

const { faq } = Astro.props;
const { data, body } = faq;
---

<details
  class="group rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800"
>
  <summary
    class="flex cursor-pointer items-center justify-between gap-3 font-semibold text-gray-900 marker:content-[''] dark:text-white"
  >
    <span>{data.question}</span>
    <span
      class="shrink-0 text-blue-600 transition-transform group-open:rotate-45 dark:text-blue-400"
      aria-hidden="true"
    >
      +
    </span>
  </summary>
  <div class="mt-3 text-sm text-gray-700 dark:text-gray-300" set:html={body} />
</details>
