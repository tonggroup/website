---
import type { CollectionEntry } from "astro:content";

type Research = CollectionEntry<"research">;

interface Props {
  research: Research;
}

const { research } = Astro.props;
const { data, id } = research;
---

<article
  class="group overflow-hidden rounded-lg border border-gray-200 bg-white transition-shadow hover:shadow-lg dark:border-gray-700 dark:bg-gray-800"
>
  <!-- Media -->
  {
    (data.video || data.image) && (
      <div class="relative aspect-square overflow-hidden bg-gray-100 p-4 dark:bg-gray-700">
        {data.video ? (
          <video
            src={data.video}
            aria-label={data.title}
            class="h-full w-full object-contain transition-transform group-hover:scale-105"
            autoplay
            loop
            muted
            playsinline
          />
        ) : (
          <img
            src={data.image!.src}
            alt={data.title}
            class="h-full w-full object-contain transition-transform group-hover:scale-105"
          />
        )}
        {data.status && (
          <span
            class:list={[
              "absolute top-3 right-3 rounded-full px-3 py-1 text-xs font-semibold text-white",
              data.status === "active"
                ? "bg-green-600"
                : data.status === "completed"
                  ? "bg-blue-600"
                  : "bg-yellow-600",
            ]}
          >
            {data.status.charAt(0).toUpperCase() + data.status.slice(1)}
          </span>
        )}
      </div>
    )
  }

  <!-- Content -->
  <div class="p-6">
    <h3 class="mb-2 line-clamp-2 text-xl font-bold">{data.title}</h3>

    {
      data.description && (
        <p class="mb-4 line-clamp-3 text-gray-700 dark:text-gray-300">
          {data.description}
        </p>
      )
    }

    <!-- Tags -->
    {
      data.tags && data.tags.length > 0 && (
        <div class="mb-4 flex flex-wrap gap-2">
          {data.tags.map(tag => (
            <span class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-800 dark:bg-blue-900 dark:text-blue-200">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <!-- Links -->
    {
      data.links && data.links.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {data.links.map(link => (
            <a
              href={link.url}
              class="inline-flex items-center gap-1 rounded-md bg-blue-600 px-3 py-1 text-sm font-medium text-white transition-colors hover:bg-blue-700"
            >
              {link.label}
              <span>→</span>
            </a>
          ))}
        </div>
      )
    }

    {
      !data.links && (
        <a
          href={`/research/${id}`}
          class="inline-flex items-center gap-1 rounded-md bg-blue-600 px-3 py-1 text-sm font-medium text-white transition-colors hover:bg-blue-700"
        >
          Learn More
          <span>→</span>
        </a>
      )
    }
  </div>
</article>
