---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconX from "@/assets/icons/IconX.svg";
import IconLinkedin from "@/assets/icons/IconLinkedin.svg";

type Team = CollectionEntry<"team">;

interface Props {
  member: Team;
}

const { member } = Astro.props;
const { data } = member;

const supervisorLabel = data.role.toLowerCase().includes("visiting")
  ? "Primary supervisor"
  : "Co-supervised with";

const socials = [
  data.github && { href: `https://github.com/${data.github}`, label: "GitHub", icon: "github" },
  data.twitter && data.twitter !== "n/a" && { href: `https://twitter.com/${data.twitter}`, label: "X", icon: "x" },
  data.linkedin && { href: `https://www.linkedin.com/in/${data.linkedin}`, label: "LinkedIn", icon: "linkedin" },
  data.website && { href: data.website, label: "Website", icon: "website" },
].filter(Boolean) as { href: string; label: string; icon: string }[];
---

<div
  class="group min-w-0 rounded-lg border border-gray-200 bg-white p-4 text-center shadow-sm transition-shadow hover:shadow-md dark:border-gray-700 dark:bg-gray-800"
>
  <!-- Photo -->
  {
    data.photo ? (
      <div class="mx-auto mb-3 h-20 w-20 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-700">
        <Image
          src={data.photo}
          alt={data.name}
          class="h-full w-full object-cover"
          width={80}
          height={80}
        />
      </div>
    ) : (
      <div class="mx-auto mb-3 flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-blue-400 to-blue-600">
        <span class="text-xl font-bold text-white">{data.name.charAt(0)}</span>
      </div>
    )
  }

  <!-- Name -->
  <h3 class="mb-1 text-base font-semibold text-gray-900 dark:text-white">
    {data.name}
  </h3>

  <!-- Role -->
  <p class="text-xs font-medium text-blue-600 dark:text-blue-400">
    {data.role}
  </p>

  <!-- Bio snippet -->
  {
    data.bio && (
      <p class="mt-2 line-clamp-3 text-xs text-gray-600 dark:text-gray-400 break-words">
        {data.bio}
      </p>
    )
  }

  <!-- Co-supervisors / Primary supervisor -->
  {
    data.coSupervisors && data.coSupervisors.length > 0 && (
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-500 break-words">
        {supervisorLabel}: {data.coSupervisors.join(", ")}
      </p>
    )
  }

  <!-- Social buttons -->
  {
    socials.length > 0 && (
      <div class="mt-3 flex justify-center gap-1.5">
        {socials.map(({ href, label, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="flex h-7 w-7 items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-blue-600 hover:text-white dark:text-gray-400 dark:hover:bg-blue-600"
          >
            {icon === "github" && <IconGitHub class="size-3.5" />}
            {icon === "x" && <IconX class="size-3.5" />}
            {icon === "linkedin" && <IconLinkedin class="size-3.5" />}
            {icon === "website" && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              </svg>
            )}
          </a>
        ))}
      </div>
    )
  }
</div>
